# Salin berkas ini menjadi .env lalu isi nilainya sesuai lingkungan Anda.
# cp .env.example .env

# ── Server ────────────────────────────────────────────────────────────────────
SERVER_PORT=8080
ENVIRONMENT=development
VERSION=1.0.0

# ── Basis data ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=password
DB_NAME=kmh_webprofile
DB_SSLMODE=disable

# ── JWT ───────────────────────────────────────────────────────────────────────
# Wajib diisi nilai acak yang panjang di production; server menolak start bila
# masih memakai nilai default.
JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_REFRESH_SECRET=ganti-dengan-string-acak-panjang-lainnya

# ── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Aplikasi & email ──────────────────────────────────────────────────────────
APP_NAME=KMH Tel-U

# Asal halaman frontend. Tautan reset password dikirim sebagai
# {FRONTEND_URL}/reset-password?token=...
FRONTEND_URL=https://leviathanbolu.my.id

# SMTP. Bila SMTP_HOST dikosongkan, email tidak dikirim dan isinya hanya
# dicetak ke log; ini memudahkan pengembangan lokal tanpa kredensial.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@leviathanbolu.my.id
SMTP_FROM_NAME=KMH Tel-U

# starttls (port 587, paling umum), ssl (port 465), atau none (relay lokal).
SMTP_ENCRYPTION=starttls

# ── Reset password ────────────────────────────────────────────────────────────
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
PASSWORD_RESET_MAX_PER_HOUR=3

# ── Contoh pengaturan SMTP per penyedia ───────────────────────────────────────
# Gmail / Google Workspace (butuh App Password, bukan password akun):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USERNAME=akun@gmail.com
#   SMTP_PASSWORD=xxxx xxxx xxxx xxxx
#
# Brevo:
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#
# Resend:
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587
#   SMTP_USERNAME=resend
#   SMTP_PASSWORD=re_xxxxxxxx
#
# SendGrid:
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_USERNAME=apikey
#   SMTP_PASSWORD=SG.xxxxxxxx
#
# Mail server domain sendiri:
#   SMTP_HOST=mail.leviathanbolu.my.id
#   SMTP_PORT=465
#   SMTP_ENCRYPTION=ssl
